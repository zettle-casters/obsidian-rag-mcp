# ===========================================
# Obsidian RAG MCP - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values

# OpenAI API Key (required for LLM operations)
OPENAI_API_KEY=sk-your-api-key-here

# OpenAI Compatibility API
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# LLM Models
OPENAI_MODEL=gpt-4o-mini
OPENAI_CHEAP_MODEL=gpt-4o-mini

# Agent settings
MAX_RECURSION_DEPTH=3
SEARCH_TOP_K=5

# ===========================================
# Auth + Postgres
# ===========================================
DATABASE_URL=postgresql+psycopg://obsidian:obsidian@localhost:5432/obsidian
POSTGRES_USER=obsidian
POSTGRES_PASSWORD=obsidian
POSTGRES_DB=obsidian
WEB_ORIGINS=http://localhost:3000
UI_BASE_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Session cookies
SESSION_COOKIE_NAME=obsidian_session
SESSION_TTL_DAYS=30
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ===========================================
# Settings below are pre-configured for Docker
# Change only for local development
# ===========================================

# Neo4j (for local dev without Docker)
# OBSIDIAN_RAG_NEO4J_URL=bolt://neo4j:test1234@localhost:7687

# Qdrant (for local dev without Docker)
# OBSIDIAN_RAG_QDRANT_HOST=localhost
# OBSIDIAN_RAG_QDRANT_PORT=6333
